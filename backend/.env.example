# Local development (MongoDB chalao apne machine par):
# MONGO_URL=mongodb://localhost:27017

# Production/deploy (MongoDB Atlas free cluster ka connection string):
MONGO_URL=mongodb+srv://<username>:<password>@<cluster-url>/?appName=Cluster0

DB_NAME=my_portfolio

# Deployed frontend ka exact URL (comma-separated, agar multiple domains hain)
CORS_ORIGINS=https://your-frontend.vercel.app

# Admin login token sign karne ke liye — production mein lambi random string do
# generate karne ke liye: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-long-random-string

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
# Gmail "App Password" use karo, normal account password nahi
SMTP_PASSWORD=your-app-password

# Contact form + new email-gate visitor notifications yahan aayenge (comma-separated)
NOTIFY_EMAILS=5yearcodepro.dev@gmail.com

# Cloudinary dashboard > API Keys se milega (images + videos yahan store honge)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
